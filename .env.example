# PostgreSQL connection string.
# For Vercel / Neon: use the pooled connection URL (includes ?sslmode=require).
# For local Docker: postgresql://user:password@localhost:5432/elessar
DATABASE_URI=postgresql://user:password@localhost:5432/elessar

# Random secret used to sign Payload JWTs. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change_me_to_a_random_secret_string

# Public URL of the Next.js server. Used by Payload for media URLs and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
